{
  "name": "kirin-terminal",
  "version": "1.0.0",
  "description": "KirinTerminal - All-in-One Terminal & Remote Sessions Client",
  "author": "Jakkit <iwired>",
  "main": "electron/main.js",
  "scripts": {
    "dev:vite": "vite",
    "dev:electron": "electron .",
    "dev": "concurrently -k \"vite\" \"node wait-and-launch.js\"",
    "start": "electron .",
    "build": "vite build",
    "dist": "vite build && electron-builder",
    "dist:win": "vite build && electron-builder --win",
    "dist:dir": "vite build && electron-builder --dir"
  },
  "build": {
    "appId": "com.iwired.kirinterminal",
    "productName": "KirinTerminal",
    "directories": {
      "output": "release"
    },
    "asar": true,
    "asarUnpack": [
      "**/node-pty/**",
      "**/serialport/**"
    ],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "KirinTerminal"
    }
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "clsx": "^2.1.1",
    "crypto-js": "^4.2.0",
    "lucide-react": "^1.16.0",
    "node-pty": "^1.1.0",
    "rc-dock": "^4.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-resizable-panels": "^4.13.3",
    "serialport": "^13.0.0",
    "ssh2": "^1.17.0",
    "tailwind-merge": "^2.6.0",
    "ws": "^8.18.0",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "xterm-addon-search": "^0.13.0",
    "xterm-addon-web-links": "^0.9.0"
  },
  "devDependencies": {
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^22.13.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/ssh2": "^1.15.6",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "electron": "^34.2.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
